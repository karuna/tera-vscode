{
  "comments": {
    // LaTeX uses % for line comments; {# #} remains available for Tera comments
    "lineComment": "%",
    "blockComment": [ "{#", "#}" ]
  },
  // symbols used as brackets
  "brackets": [
    [ "{{", "}}" ],
    [ "{%", "%}" ],
    [ "{#", "#}" ],
    [ "{", "}" ],
    [ "[", "]" ],
    [ "(", ")" ]
  ],
  // symbols that are auto closed when typing
  "autoClosingPairs": [
    [ "{{", "}}" ],
    [ "{%", "%}" ],
    [ "{#", "#}" ],
    [ "{", "}" ],
    [ "[", "]" ],
    [ "(", ")" ],
    [ "$", "$" ]
  ],
  // symbols that that can be used to surround a selection
  "surroundingPairs": [
    [ "{", "}" ],
    [ "[", "]" ],
    [ "(", ")" ],
    [ "$", "$" ]
  ],
  "folding": {
    "markers": {
      "start": "{%\\s*(block|filter|for|if|macro|raw)|\\\\begin\\{",
      "end": "{%\\s*end(block|filter|for|if|macro|raw)\\s*%}|\\\\end\\{"
    }
  }
}
