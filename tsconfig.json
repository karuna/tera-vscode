{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "ES2022"
        ],
        "module": "node18",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "vscode"
        ],
        "forceConsistentCasingInFileNames": true,
        "outDir": "out",
        "rootDir": "src"
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
