{
  "name": "tera",
  "scopeName": "source.tera",
  "comment": "Tera Templates (Tera 2, with Tera 1 tags retained)",
  "foldingStartMarker": "({%-?\\s*(block|filter|for|if|macro|raw|component)\\b)",
  "foldingStopMarker": "({%-?\\s*end(block|filter|for|if|macro|raw|component|set)\\b)",
  "patterns": [
    {
      "begin": "({%-?)\\s*(raw)\\s*(-?%})",
      "captures": {
        "1": {
          "name": "entity.other.tera.delimiter.tag"
        },
        "2": {
          "name": "keyword.control.tera"
        },
        "3": {
          "name": "entity.other.tera.delimiter.tag"
        }
      },
      "end": "({%-?)\\s*(endraw)\\s*(-?%})",
      "name": "comment.block.tera.raw"
    },
    {
      "include": "#comments"
    },
    {
      "begin": "{{-?",
      "captures": [
        {
          "name": "variable.entity.other.tera.delimiter"
        }
      ],
      "end": "-?}}",
      "name": "variable.meta.scope.tera",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    {
      "begin": "{%-?",
      "captures": [
        {
          "name": "entity.other.tera.delimiter.tag"
        }
      ],
      "end": "-?%}",
      "name": "meta.scope.tera.tag",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "begin": "{#-?",
      "captures": [
        {
          "name": "entity.other.tera.delimiter.comment"
        }
      ],
      "end": "-?#}",
      "name": "comment.block.tera",
      "patterns": [
        {
          "include": "#comments"
        }
      ]
    },
    "escaped_char": {
      "match": "\\\\x[0-9A-F]{2}",
      "name": "constant.character.escape.hex.tera"
    },
    "escaped_unicode_char": {
      "captures": {
        "1": {
          "name": "constant.character.escape.unicode.16-bit-hex.tera"
        },
        "2": {
          "name": "constant.character.escape.unicode.32-bit-hex.tera"
        },
        "3": {
          "name": "constant.character.escape.unicode.name.tera"
        }
      },
      "match": "(\\\\U[0-9A-Fa-f]{8})|(\\\\u[0-9A-Fa-f]{4})|(\\\\N\\{[a-zA-Z ]+\\})"
    },
    "expression": {
      "patterns": [
        {
          "match": "\\s*\\b(component)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            },
            "2": {
              "name": "entity.name.function.component.tera"
            }
          }
        },
        {
          "match": "\\s*\\b(endcomponent)(?:\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*))?",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            },
            "2": {
              "name": "entity.name.function.component.tera"
            }
          }
        },
        {
          "match": "\\s*\\b(block)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            },
            "2": {
              "name": "variable.other.tera.block"
            }
          }
        },
        {
          "match": "\\s*\\b(filter)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            },
            "2": {
              "name": "variable.other.tera.filter"
            }
          }
        },
        {
          "match": "\\b(is)\\s+(?:(not)\\s+)?(starting_with|divisible_by|ending_with|containing|undefined|iterable|defined|integer|number|string|array|float|bool|even|none|map|odd)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            },
            "2": {
              "name": "keyword.control.tera"
            },
            "3": {
              "name": "support.function.test.tera"
            }
          }
        },
        {
          "match": "\\b(is)\\s+(?:(not)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            },
            "2": {
              "name": "keyword.control.tera"
            },
            "3": {
              "name": "variable.other.tera.test"
            }
          }
        },
        {
          "name": "meta.tag.component.tera",
          "begin": "(</?)([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)(?=[\\s/>])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.tera"
            },
            "2": {
              "name": "entity.name.tag.component.tera"
            }
          },
          "end": "(/?>)|(?=-?%\\}|-?\\}\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.tera"
            }
          },
          "patterns": [
            {
              "match": "\\.\\.\\.",
              "name": "keyword.operator.spread.tera"
            },
            {
              "match": "([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*=)",
              "name": "entity.other.attribute-name.tera"
            },
            {
              "include": "#expression"
            }
          ]
        },
        {
          "match": "(?<=\\{\\%-|\\{\\%)\\s*\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?!\\s*[,=])",
          "captures": {
            "1": {
              "name": "keyword.control.tera"
            }
          }
        },
        {
          "match": "\\b(and|as|block|break|component|continue|elif|else|endblock|endcomponent|endfilter|endfor|endif|endraw|endset|extends|filter|for|if|import|in|include|is|macro|endmacro|not|or|raw|recursive|set_global|set|with(out)?\\s+context)\\b",
          "name": "keyword.control.tera"
        },
        {
          "match": "\\b(true|True|false|False|none|None|null)\\b",
          "name": "constant.language.tera"
        },
        {
          "match": "\\b(loop|super|self|body|varargs|kwargs)\\b",
          "name": "variable.language.tera"
        },
        {
          "match": "\\b(range|throw)\\b(?=\\s*\\()",
          "name": "support.function.builtin.tera"
        },
        {
          "match": "(\\|)\\s*(newlines_to_br|escape_html|capitalize|escape_xml|trim_start|pluralize|wordcount|group_by|trim_end|truncate|default|replace|reverse|double|escape|indent|length|unique|values|first|float|lower|pairs|round|shout|split|title|upper|join|keys|last|safe|sort|trim|abs|get|int|nth|str)\\b",
          "captures": {
            "1": {
              "name": "punctuation.other.tera"
            },
            "2": {
              "name": "support.function.filter.tera"
            }
          }
        },
        {
          "match": "(\\|)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.other.tera"
            },
            "2": {
              "name": "variable.other.tera.filter"
            }
          }
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.spread.tera"
        },
        {
          "match": "(\\?\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.optional-chaining.tera"
            },
            "2": {
              "name": "variable.other.tera.attribute"
            }
          }
        },
        {
          "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.other.tera"
            },
            "2": {
              "name": "variable.other.tera.attribute"
            }
          }
        },
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
          "name": "constant.numeric.tera"
        },
        {
          "match": "[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.other.tera"
        },
        {
          "match": "(\\*\\*|//|\\+|\\-|\\*|/|%|~)",
          "name": "keyword.operator.arithmetic.tera"
        },
        {
          "begin": "\\[",
          "captures": [
            {
              "name": "punctuation.other.tera"
            }
          ],
          "end": "\\]",
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "\\(",
          "captures": [
            {
              "name": "punctuation.other.tera"
            }
          ],
          "end": "\\)",
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "\\{",
          "captures": [
            {
              "name": "punctuation.other.tera"
            }
          ],
          "end": "\\}",
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "match": "(\\.|:|\\||,)",
          "name": "punctuation.other.tera"
        },
        {
          "match": "(==|!=|<=|>=|<|>)",
          "name": "keyword.operator.comparison.tera"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.tera"
        },
        {
          "begin": "\"",
          "beginCaptures": [
            {
              "name": "punctuation.definition.string.begin.tera"
            }
          ],
          "end": "\"",
          "endCaptures": [
            {
              "name": "punctuation.definition.string.end.tera"
            }
          ],
          "name": "string.quoted.double.tera",
          "patterns": [
            {
              "include": "#string"
            }
          ]
        },
        {
          "begin": "'",
          "beginCaptures": [
            {
              "name": "punctuation.definition.string.begin.tera"
            }
          ],
          "end": "'",
          "endCaptures": [
            {
              "name": "punctuation.definition.string.end.tera"
            }
          ],
          "name": "string.quoted.single.tera",
          "patterns": [
            {
              "include": "#string"
            }
          ]
        },
        {
          "begin": "@/",
          "beginCaptures": [
            {
              "name": "punctuation.definition.regexp.begin.tera"
            }
          ],
          "end": "/",
          "endCaptures": [
            {
              "name": "punctuation.definition.regexp.end.tera"
            }
          ],
          "name": "string.regexp.tera",
          "patterns": [
            {
              "include": "#simple_escapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.backtick.tera",
          "begin": "`",
          "beginCaptures": [
            {
              "name": "punctuation.definition.string.begin.tera"
            }
          ],
          "end": "`",
          "endCaptures": [
            {
              "name": "punctuation.definition.string.end.tera"
            }
          ],
          "patterns": [
            {
              "include": "#string"
            }
          ]
        }
      ]
    },
    "simple_escapes": {
      "captures": {
        "1": {
          "name": "constant.character.escape.newline.tera"
        },
        "10": {
          "name": "constant.character.escape.tab.tera"
        },
        "11": {
          "name": "constant.character.escape.vertical-tab.tera"
        },
        "2": {
          "name": "constant.character.escape.backlash.tera"
        },
        "3": {
          "name": "constant.character.escape.double-quote.tera"
        },
        "4": {
          "name": "constant.character.escape.single-quote.tera"
        },
        "5": {
          "name": "constant.character.escape.bell.tera"
        },
        "6": {
          "name": "constant.character.escape.backspace.tera"
        },
        "7": {
          "name": "constant.character.escape.formfeed.tera"
        },
        "8": {
          "name": "constant.character.escape.linefeed.tera"
        },
        "9": {
          "name": "constant.character.escape.return.tera"
        }
      },
      "match": "(\\\\\\n)|(\\\\\\\\)|(\\\\\\\")|(\\\\')|(\\\\a)|(\\\\b)|(\\\\f)|(\\\\n)|(\\\\r)|(\\\\t)|(\\\\v)"
    },
    "string": {
      "patterns": [
        {
          "include": "#simple_escapes"
        },
        {
          "include": "#escaped_char"
        },
        {
          "include": "#escaped_unicode_char"
        }
      ]
    }
  }
}
